# PostgreSQL connection string. Matches the local docker-compose service below.
# Any Postgres works (local, Neon, Supabase, Vercel Postgres, Railway...).
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/urban_company?schema=public"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app. Update this to your deployed URL in production.
NEXTAUTH_URL="http://localhost:3000"
